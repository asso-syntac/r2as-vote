{% extends 'base.html.twig' %}

{% block title %}Vote clos - {{ event.name }}{% endblock %}

{% block body %}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-lg shadow-lg p-8 text-center">
        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-red-100 mb-4">
            <svg class="h-8 w-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>

        <h1 class="text-2xl font-bold text-gray-900 mb-2">Bonjour {{ user.name }}</h1>
        <h2 class="text-lg text-gray-700 mb-2">{{ event.name }}</h2>
        {% if event.description %}
            <p class="text-gray-600 mb-6">{{ event.description }}</p>
        {% endif %}

        <div class="bg-red-50 border-l-4 border-red-500 p-4 text-left rounded mb-4">
            <p class="text-sm text-red-800">
                L'organisateur a clos ce vote. Vous ne pouvez plus voter.
            </p>
        </div>

        <p class="text-sm text-gray-500">
            Pour toute question, contactez l'organisateur :
            <a href="mailto:{{ event.mail }}" class="text-r2as-primary hover:text-r2as-secondary underline">{{ event.mail }}</a>
        </p>
    </div>
</div>

{% endblock %}
