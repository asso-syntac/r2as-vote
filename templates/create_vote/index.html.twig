{% extends 'base.html.twig' %}

{% block title %}Créer un vote{% endblock %}

{% block body %}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-lg shadow-lg p-8">
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Créer un nouveau vote</h1>
            <p class="text-gray-600">Remplissez les informations ci-dessous pour créer votre vote.</p>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

        <div>
            <label for="{{ form.name.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">
                Nom de votre vote
            </label>
            {{ form_widget(form.name, {'attr': {
                'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-r2as-primary focus:border-transparent',
                'autocomplete': 'off'
            }}) }}
            <div class="mt-1 text-sm text-red-700" role="alert">{{ form_errors(form.name) }}</div>
        </div>

        <div>
            <label for="{{ form.description.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">
                Description de votre vote
            </label>
            {{ form_widget(form.description, {'attr': {
                'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-r2as-primary focus:border-transparent',
                'rows': '4',
                'aria-describedby': form.description.vars.id ~ '-help'
            }}) }}
            <div class="mt-1 text-sm text-red-700" role="alert">{{ form_errors(form.description) }}</div>
            <p id="{{ form.description.vars.id }}-help" class="mt-1 text-sm text-gray-500">Décrivez le contexte et les objectifs de votre vote.</p>
        </div>

        <div>
            <label for="{{ form.mail.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">
                Votre adresse email
            </label>
            {{ form_widget(form.mail, {'attr': {
                'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-r2as-primary focus:border-transparent',
                'autocomplete': 'email',
                'inputmode': 'email',
                'aria-describedby': form.mail.vars.id ~ '-help'
            }}) }}
            <div class="mt-1 text-sm text-red-700" role="alert">{{ form_errors(form.mail) }}</div>
            <p id="{{ form.mail.vars.id }}-help" class="mt-1 text-sm text-gray-500">Vous recevrez par email un lien d'administration unique. Conservez-le précieusement : il ne peut pas être renvoyé.</p>
        </div>

        <div class="flex items-center justify-between pt-4">
            <a href="/" class="text-gray-600 hover:text-gray-900 font-medium">
                ← Retour
            </a>
            {{ form_widget(form.save, {'label': 'Créer le vote', 'attr': {'class': 'px-6 py-3 bg-r2as-primary hover:bg-r2as-secondary text-white font-semibold rounded-lg shadow-md transition duration-200 transform hover:scale-105 motion-reduce:transform-none motion-reduce:transition-none'}}) }}
        </div>

        {{ form_end(form) }}
    </div>
</div>

{% endblock %}
