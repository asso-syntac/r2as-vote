{% extends 'base.html.twig' %}

{% block title %}Import en masse - {{ event.name }}{% endblock %}

{% block body %}

<div class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav aria-label="Fil d’ariane" class="mb-6">
        <a href="{{ path('param_vote', { uuid: uuid }) }}" class="text-r2as-primary hover:text-r2as-secondary font-medium">
            ← {{ event.name }}
        </a>
    </nav>

    <div class="bg-white rounded-lg shadow-lg p-8">
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Import de votants en masse</h1>
            <p class="text-gray-600">Importez plusieurs votants à la fois au format CSV.</p>
        </div>

        <!-- Instructions -->
        <div class="mb-8 space-y-4">
            <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded">
                <div class="flex">
                    <svg class="w-6 h-6 text-blue-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div class="flex-1">
                        <h3 class="text-blue-900 font-semibold mb-2">Format CSV à utiliser</h3>
                        <div class="bg-white p-3 rounded border border-blue-200 font-mono text-sm text-gray-800">
                            nom,mail,nombreDeVoix
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded">
                <div class="flex">
                    <svg class="w-6 h-6 text-green-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div class="flex-1">
                        <h3 class="text-green-900 font-semibold mb-2">Exemple</h3>
                        <div class="bg-white p-3 rounded border border-green-200 font-mono text-sm text-gray-800 whitespace-pre">Julien Lepers,julien@lepers.fr,2
Mathilde Durand,contact@blabla.com,1
Pierre Martin,pierre@example.com,3</div>
                    </div>
                </div>
            </div>

            <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4 rounded">
                <div class="flex">
                    <svg class="w-6 h-6 text-yellow-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <div class="flex-1">
                        <p class="text-yellow-900 font-semibold">Recommandation</p>
                        <p class="text-yellow-800 text-sm mt-1">Maximum 500 votants à la fois. Le traitement peut prendre quelques instants.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulaire -->
        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

        <div>
            <label for="{{ form.csv.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">
                <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Liste des votants au format CSV
                </span>
            </label>
            {{ form_widget(form.csv, {'attr': {
                'class': 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-r2as-primary focus:border-transparent font-mono text-sm',
                'rows': '12',
                'placeholder': 'nom,mail,nombreDeVoix\nJean Dupont,jean@example.com,1',
                'aria-describedby': form.csv.vars.id ~ '-help'
            }}) }}
            <div class="mt-1 text-sm text-red-700" role="alert">{{ form_errors(form.csv) }}</div>
            <p id="{{ form.csv.vars.id }}-help" class="mt-2 text-sm text-gray-500">Collez votre liste CSV ci-dessus et patientez après validation.</p>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-gray-200">
            <a href="{{ path('param_vote', { uuid: uuid }) }}" class="text-gray-600 hover:text-gray-900 font-medium">
                ← Annuler
            </a>
            {{ form_widget(form.save, {'label': 'Importer les votants', 'attr': {'class': 'inline-flex items-center px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg shadow-md transition duration-200 transform hover:scale-105 motion-reduce:transform-none motion-reduce:transition-none'}}) }}
        </div>

        {{ form_end(form) }}
    </div>
</div>

{% endblock %}
