{% extends 'base.html.twig' %}

{% block title %}Ajouter un votant - {{ event.name }}{% endblock %}

{% block body %}

<div class="max-w-2xl mx-auto">
    <!-- Breadcrumb -->
    <nav aria-label="Fil d’ariane" class="mb-6">
        <a href="/param-vote/{{uuid}}" class="text-r2as-primary hover:text-r2as-secondary font-medium">
            ← {{ event.name }}
        </a>
    </nav>

    <!-- Formulaire -->
    <div class="bg-white rounded-lg shadow-lg p-8">
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Ajouter un votant</h1>
            <p class="text-gray-600">Le votant recevra un email avec son lien de vote personnel.</p>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

        <div>
            <label for="{{ form.mail.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">
                <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    Adresse email du votant
                </span>
            </label>
            {{ form_widget(form.mail, {'attr': {
                'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-r2as-primary focus:border-transparent',
                'placeholder': 'exemple@email.com',
                'autocomplete': 'email',
                'inputmode': 'email',
                'aria-describedby': form.mail.vars.id ~ '-help'
            }}) }}
            <div class="mt-1 text-sm text-red-700" role="alert">{{ form_errors(form.mail) }}</div>
            <p id="{{ form.mail.vars.id }}-help" class="mt-1 text-sm text-gray-500">L'email d'invitation sera envoyé à cette adresse.</p>
        </div>

        <div>
            <label for="{{ form.name.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">
                <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    Nom du votant
                </span>
            </label>
            {{ form_widget(form.name, {'attr': {
                'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-r2as-primary focus:border-transparent',
                'placeholder': 'Nicolas de Condorcet',
                'autocomplete': 'name'
            }}) }}
            <div class="mt-1 text-sm text-red-700" role="alert">{{ form_errors(form.name) }}</div>
        </div>

        <div>
            <label for="{{ form.factor.vars.id }}" class="block text-sm font-medium text-gray-700 mb-2">
                <span class="flex items-center">
                    <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
                    </svg>
                    Nombre de voix (pondération)
                </span>
            </label>
            {{ form_widget(form.factor, {'attr': {
                'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-r2as-primary focus:border-transparent',
                'inputmode': 'numeric',
                'pattern': '[0-9]*',
                'min': '1'
            }}) }}
            <div class="mt-1 text-sm text-red-700" role="alert">{{ form_errors(form.factor) }}</div>
            <p class="mt-1 text-sm text-gray-500">Définit le poids du vote de cette personne (1-10).</p>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-gray-200">
            <a href="/param-vote/{{uuid}}" class="text-gray-600 hover:text-gray-900 font-medium">
                ← Annuler
            </a>
            {{ form_widget(form.save, {'label': 'Ajouter le votant', 'attr': {'class': 'inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md transition duration-200 transform hover:scale-105 motion-reduce:transform-none motion-reduce:transition-none'}}) }}
        </div>

        {{ form_end(form) }}
    </div>
</div>

{% endblock %}
